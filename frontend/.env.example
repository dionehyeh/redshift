# Clerk keys come from the Clerk Dashboard. Keep the secret key server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/fields
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/fields

# Backend API URL (server-to-server)
API_BASE_URL=http://localhost:8000

# Optional GET-only mock data for local UI work when the backend is offline.
NEXT_PUBLIC_USE_MOCK_API=false

NEXT_PUBLIC_DEFAULT_LOCALE=en
