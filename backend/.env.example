# Neon PostgreSQL connection string; select "Pooled connection" in Neon.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Clerk instance values. The secret key is shared with the frontend server env.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

ALLOWED_ORIGINS=http://localhost:3000
CACHE_DIR=data/cache

# Optional Earth data credentials
EARTHDATA_USER=
EARTHDATA_PASSWORD=
EE_PROJECT=

# Optional narrative generation
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
