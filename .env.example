# ==============================================================================
# Field Shift: Adapting Farms with NASA Data (Root Environment Configuration)
# ==============================================================================

# Neon PostgreSQL and Clerk settings (also listed in backend/.env.example)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
ALLOWED_ORIGINS=http://localhost:3000
CACHE_DIR=data/cache

# NASA Earthdata Authentication (optional)
EARTHDATA_USER=
EARTHDATA_PASSWORD=

# Google Earth Engine (Optional in DEMO_MODE=1)
EE_PROJECT=

# LLM Explanation Service (Optional - fallbacks to deterministic templates if unset)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Frontend Configuration (also listed in frontend/.env.example)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en
